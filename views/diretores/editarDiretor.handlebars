<h1 class="uk-heading-small">Editar Diretor</h1>

<form class="uk-form-stacked uk-width-1-2@m" action="/diretores/{{diretor.id}}?_method=PUT" method="POST">

  <div class="uk-margin">
    <label class="uk-form-label">Nome do Diretor:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="text" name="nome" value="{{diretor.nome}}">
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label">Ano de Nascimento:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="number" name="anoNascimento" value="{{diretor.anoNascimento}}">
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label">Nacionalidade:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="text" name="nacionalidade" value="{{diretor.nacionalidade}}">
    </div>
  </div>

  <button class="uk-button uk-button-primary" type="submit">Editar</button>
  <a class="uk-button uk-button-default" href="/diretores">Cancelar</a>

</form>