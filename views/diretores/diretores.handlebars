<div class="uk-flex uk-flex-between uk-flex-middle">
  <h1 class="uk-heading-small uk-margin-remove">Lista de Diretores</h1>
  <a class="uk-button uk-button-primary" href="/diretores/cadastrar">
    <span uk-icon="plus"></span> Cadastrar Diretor
  </a>
</div>

<hr>

{{#if diretores.length}}

  <table class="uk-table uk-table-divider uk-table-hover uk-table-middle">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Ano de Nascimento</th>
        <th>Nacionalidade</th>
        <th class="uk-table-shrink">Ações</th>
      </tr>
    </thead>
    <tbody>
      {{#each diretores}}
        <tr>
          <td><a href="/diretores/{{this.id}}">{{this.nome}}</a></td>
          <td>{{this.anoNascimento}}</td>
          <td>{{this.nacionalidade}}</td>
          <td class="uk-text-nowrap">
            <a class="uk-icon-button uk-margin-small-right" href="/diretores/{{this.id}}/editar" uk-icon="pencil" title="Editar"></a>
            <form action="/diretores/{{this.id}}?_method=DELETE" method="POST" style="display: inline;">
              <button class="uk-icon-button uk-button-danger" type="submit" uk-icon="trash" title="Excluir"></button>
            </form>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>

{{else}}

  <div class="uk-alert uk-alert-primary" uk-alert>
    <p>Nenhum diretor cadastrado.</p>
  </div>

{{/if}}