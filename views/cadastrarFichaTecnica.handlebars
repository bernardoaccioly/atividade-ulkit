<h1>Ficha Técnica - {{filme.nome}}</h1>

<hr>

<form action="/filmes/{{filme.id}}/ficha-tecnica" method="POST">

  <div>
    <label>Duração (minutos):</label>
    <input type="number" name="duracaoMinutos" required>
  </div>

  <br>

  <div>
    <label>Orçamento:</label>
    <input type="number" step="0.01" name="orcamento" required>
  </div>

  <br>

  <div>
    <label>Bilheteria:</label>
    <input type="number" step="0.01" name="bilheteria" required>
  </div>

  <br>

<button type="submit">Salvar</button>

</form>

<br>

<a href="/filmes/{{filme.id}}">
  Voltar para o filme
</a>
