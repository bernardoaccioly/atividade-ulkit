<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<a href="/">
  Inicial
</a><br>

<a href="/filmes">
  Filmes
</a>

<h1>Detalhar Filme</h1>

<hr>

<ul>

```
<label>Nome:</label>
{{filme.nome}}
<br>

<label>Ano:</label>
{{filme.ano}}
<br>

<label>Diretor:</label>
<a href='/diretores/{{filme.diretor.id}}'>
  {{filme.diretor.nome}} - {{filme.diretor.anoNascimento}} - {{filme.diretor.nacionalidade}}
</a>
<br>
<br>

<label>Artistas:</label>
<ul>
  {{#each filme.artistas}}
    <li>
      <a href='/artistas/{{this.id}}'>
        {{this.nome}} - {{this.anoNascimento}}
      </a>
    </li>
  {{/each}}
</ul>

<br>

<h2>TESTE FICHA TÉCNICA</h2>


<label>Ficha Técnica:</label>

{{#if filme.fichaTecnica}}

  <ul>
    <li>
      Duração: {{filme.fichaTecnica.duracaoMinutos}} minutos
    </li>

    <li>
      Orçamento: {{filme.fichaTecnica.orcamento}}
    </li>

    <li>
      Bilheteria: {{filme.fichaTecnica.bilheteria}}
    </li>
  </ul>

{{else}}

  <p>Este filme ainda não possui uma ficha técnica.</p>

  <a href="/filmes/{{filme.id}}/ficha-tecnica/cadastrar">
    Cadastrar ficha técnica
  </a>

{{/if}}
```

</ul>
