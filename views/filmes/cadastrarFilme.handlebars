<h1 class="uk-heading-small">Cadastrar Filme</h1>

<form class="uk-form-stacked uk-width-1-2@m" action="/filmes" method="POST">

  <div class="uk-margin">
    <label class="uk-form-label">Nome do Filme:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="text" name="nome">
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label">Ano:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="number" name="ano">
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label">Diretor:</label>
    <div class="uk-form-controls">
      <select class="uk-select" name="diretorId">
        {{#each diretores}}
          <option value="{{this.id}}">{{this.nome}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label">Artistas:</label>
    <div class="uk-form-controls">
      <select class="uk-select" name="artistas" multiple size="5">
        {{#each artistas}}
          <option value="{{this.id}}">{{this.nome}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <button class="uk-button uk-button-primary" type="submit">Cadastrar</button>
  <a class="uk-button uk-button-default" href="/filmes">Cancelar</a>

</form>