<h1 class="uk-heading-small">Ficha Técnica - {{filme.nome}}</h1>

<hr>

<form class="uk-form-stacked uk-width-1-2@m" action="/filmes/{{filme.id}}/ficha-tecnica" method="POST">

  <div class="uk-margin">
    <label class="uk-form-label">Duração (minutos):</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="number" name="duracaoMinutos" required>
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label">Orçamento:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="number" step="0.01" name="orcamento" required>
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label">Bilheteria:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="number" step="0.01" name="bilheteria" required>
    </div>
  </div>

  <button class="uk-button uk-button-primary" type="submit">Salvar</button>
  <a class="uk-button uk-button-default" href="/filmes/{{filme.id}}">Voltar para o filme</a>

</form>